<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: the launcher splash is fully handled by Theme.VidMax.Splash
         (core-splashscreen maps windowSplashScreen* attrs itself).
         The old overrides that forced a transparent icon caused the blank
         black screen on Android 12+, so they were removed. -->
    <style name="Theme.VidMax.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
